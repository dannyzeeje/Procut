import { ColorWheel, CurveEditor } from "../inspector/grading.slint";
import { Select } from "../primitives/select.slint";
import { Editor } from "../editor.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { PhoneCommand } from "clip-tools.slint";
import { PhoneValue } from "value.slint";

export component PhoneColorShots inherits Flickable {
    callback picked(id: string);
    content-width: shots.width;
    content-height: self.height;
    shots := HorizontalLayout {
        width: Math.max(root.width, self.preferred-width);
        height: root.height;
        spacing: 6px;
        alignment: start;

        for shot in Editor.phone-color-shots: Rectangle {
            width: 84px;
            clip: true;
            border-radius: Theme.r;
            background: Theme.well;
            border-width: shot.id == Editor.primary-selected-id ? 2px : 0px;
            border-color: Theme.accent;
            opacity: shot.editable ? 1 : 0.45;
            accessible-role: button;
            accessible-label: shot.name;
            Image {
                x: 2px; y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                source: shot.poster;
                image-fit: cover;
            }
            Text {
                x: 2px;
                y: parent.height - self.height - 2px;
                width: parent.width - 4px;
                height: 18px;
                text: shot.name;
                color: #fff;
                stroke: #000;
                stroke-width: 1px;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                enabled: shot.editable;
                clicked => { root.picked(shot.id); }
            }
        }
    }
}

export component PhoneColorTools inherits VerticalLayout {
    in-out property <string> selected-key: "exposure";
    in property <bool> before;
    callback compare(before: bool);
    callback advanced();
    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;
        for p in Editor.phone-color-params: PhoneCommand {
            label: p.label;
            selected: root.selected-key == p.key;
            enabled: Editor.phone-can-grade && !root.before;
            clicked => { Editor.blur(); root.selected-key = p.key; }
        }
    }
    for p in Editor.phone-color-params: VerticalLayout {
        if p.key == root.selected-key: PhoneValue {
            label: p.label;
            unit: p.unit;
            value: p.value;
            minimum: p.min;
            maximum: p.max;
            step: p.step;
            detent: p.default-value;
            enabled: Editor.phone-can-grade && !root.before;
            started => { Editor.phone-edit-started(); }
            edited(v) => { Editor.adjust-set(p.key, v); Editor.phone-edit-preview(); }
            finished => { Editor.phone-edit-finished(); }
        }
    }
    if !Editor.phone-can-grade: Text {
        text: I18n.t("mobile.selectShot");
        color: Theme.fg-muted;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    HorizontalLayout {
        spacing: 4px;
        PhoneCommand {
            label: I18n.t("mobile.beforeGrade");
            selected: root.before;
            enabled: Editor.phone-can-grade;
            clicked => { root.compare(true); }
        }
        PhoneCommand {
            label: I18n.t("mobile.afterGrade");
            selected: !root.before;
            enabled: Editor.phone-can-grade;
            clicked => { root.compare(false); }
        }
        PhoneCommand {
            label: I18n.t("phone.more");
            enabled: Editor.phone-can-grade && !root.before;
            clicked => { root.advanced(); }
        }
    }
}

export component PhoneCameraInput inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;

    Text { text: I18n.t("mobile.cameraProfile"); color: Theme.fg; }
    Select {
        height: 48px;
        row-h: 48px;
        property <int> selected: Editor.phone-camera-profile;
        current: self.selected;
        changed selected => { self.current = self.selected; }
        options: [I18n.t("common.off"), "Sony S-Log3 / S-Gamut3.Cine", "Sony S-Log3 / S-Gamut3", "Panasonic V-Log / V-Gamut"];
        changed(index) => { Editor.phone-camera-input(index, Editor.phone-camera-levels); }
    }
    if Editor.phone-camera-profile > 0: VerticalLayout {
        spacing: 8px;
        Text { text: I18n.t("mobile.decodedLevels"); color: Theme.fg; }
        Select {
            height: 48px;
            row-h: 48px;
            property <int> selected: Editor.phone-camera-levels;
            current: self.selected;
            changed selected => { self.current = self.selected; }
            options: [I18n.t("mobile.fullCodeValues"), I18n.t("mobile.expandedVideoLevels")];
            changed(index) => { Editor.phone-camera-input(Editor.phone-camera-profile, index); }
        }
    }
}

export component PhoneGradeLayers inherits VerticalLayout {
    property <int> active: -1;
    property <int> bank;
    property <string> clip-id: Editor.primary-selected-id;
    changed clip-id => { root.active = -1; root.bank = 0; }
    padding: 12px;
    spacing: 6px;

    PhoneCommand {
        label: I18n.t("mobile.addGradeLayer");
        clicked => {
            Editor.blur();
            Editor.phone-grade-layer("add", -1);
            if (Editor.phone-grade-layers.length > 0) {
                root.active = Editor.phone-grade-layers[Editor.phone-grade-layers.length - 1].index;
                root.bank = 0;
            }
        }
    }
    for layer in Editor.phone-grade-layers: VerticalLayout {
        spacing: 4px;
        PhoneCommand {
            label: layer.name;
            selected: root.active == layer.index;
            clicked => {
                Editor.blur();
                root.active = root.active == layer.index ? -1 : layer.index;
                root.bank = layer.primaries ? 0 : layer.wheels ? 1 : layer.curves ? 2 : 0;
            }
        }
        if root.active == layer.index: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 4px;
                PhoneCommand {
                    label: layer.on ? I18n.t("mobile.gradeEnabled") : I18n.t("mobile.gradeBypassed");
                    selected: layer.on;
                    clicked => { Editor.blur(); Editor.phone-grade-layer("toggle", layer.index); }
                }
                PhoneCommand {
                    label: I18n.t("mobile.moveUp");
                    enabled: layer.up;
                    clicked => { Editor.blur(); Editor.phone-grade-layer("up", layer.index); root.active = -1; }
                }
                PhoneCommand {
                    label: I18n.t("mobile.moveDown");
                    enabled: layer.down;
                    clicked => { Editor.blur(); Editor.phone-grade-layer("down", layer.index); root.active = -1; }
                }
                PhoneCommand {
                    label: I18n.t("common.remove");
                    clicked => { Editor.blur(); Editor.phone-grade-layer("remove", layer.index); root.active = -1; }
                }
            }
            if layer.on: VerticalLayout {
                spacing: 6px;
                if layer.primaries: HorizontalLayout {
                    spacing: 4px;
                    PhoneCommand { label: I18n.t("common.adjust"); selected: root.bank == 0; clicked => { Editor.blur(); root.bank = 0; } }
                    PhoneCommand { label: "RGB"; selected: root.bank == 3; clicked => { Editor.blur(); root.bank = 3; } }
                    PhoneCommand { label: I18n.t("mobile.colorWheels"); selected: root.bank == 1; clicked => { Editor.blur(); root.bank = 1; } }
                    PhoneCommand { label: I18n.t("keyframesPane.curves"); selected: root.bank == 2; clicked => { Editor.blur(); root.bank = 2; } }
                }
                for p in Editor.phone-grade-params: group-box := VerticalLayout {
                    property <bool> channel: p.group == "Gamma channels" || p.group == "Gain channels";
                    if p.entry == layer.index && ((root.bank == 0 && !group-box.channel) || (root.bank == 3 && group-box.channel)): PhoneValue {
                        label: p.label; unit: p.unit; value: p.value;
                        minimum: p.min; maximum: p.max; step: p.step; detent: p.default-value;
                        enabled: !p.keyed || p.keyable;
                        started => { Editor.phone-edit-started(); }
                        edited(v) => { Editor.chain-set-param(false, p.entry, p.key, v); Editor.phone-edit-preview(); }
                        finished => { Editor.phone-edit-finished(); }
                    }
                }
                for group in Editor.visual-wheels: VerticalLayout {
                    if root.bank == 1 && group.entry == layer.index: VerticalLayout {
                        spacing: 6px;
                        for wheel in group.wheels: ColorWheel {
                            data: wheel;
                            moved(x, y) => { Editor.chain-set-param(false, wheel.entry, wheel.key + ".x", x); Editor.chain-set-param(false, wheel.entry, wheel.key + ".y", y); Editor.clip-commit(); }
                            master-changed(v) => { Editor.chain-set-param(false, wheel.entry, wheel.key + ".m", v); Editor.clip-commit(); }
                        }
                    }
                }
                for group in Editor.visual-curves: VerticalLayout {
                    if root.bank == 2 && group.entry == layer.index: CurveEditor {
                        curves: group.curves;
                        point(key, index, x, y) => { Editor.curve-point(group.entry, key, index, x, y); Editor.clip-commit(); }
                        remove(key, index) => { Editor.curve-remove(group.entry, key, index); Editor.clip-commit(); }
                    }
                }
            }
        }
    }
}
