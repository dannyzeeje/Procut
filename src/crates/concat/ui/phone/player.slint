import { RoundButton } from "controls.slint";
import { Editor } from "../editor.slint";
import { Fmt } from "../util.slint";
import { Theme } from "../theme/theme.slint";
import { I18n } from "../i18n.slint";
import { Glyph } from "../icons.slint";
export component PhoneTransport inherits Rectangle {
    callback fullscreen();
    background: Theme.page;

    height: 52px;
    HorizontalLayout {
        width: parent.width; height: parent.height;
        padding-left: 4px; padding-right: 4px; spacing: 0px;
        Text {
            min-width: 0px;
            horizontal-stretch: 1;
            text: Fmt.frames-timecode(Editor.playhead, Editor.frame-rate);
            color: Theme.fg; font-size: Theme.fs-sm; font-family: Theme.font-technical;
            vertical-alignment: center; horizontal-alignment: center; overflow: elide;
        }
        RoundButton { size: 44px; glyph: Glyph.step-back; label: I18n.t("previewPane.previousFrame"); repeats: true; clicked => { Editor.step-frames(-1); } }
        RoundButton { glyph: Editor.playing ? Glyph.pause : Glyph.play; label: Editor.playing ? I18n.t("previewPane.pause") : I18n.t("previewPane.play"); accent: true; size: 48px; clicked => { Editor.play-toggled(); } }
        RoundButton { size: 44px; glyph: Glyph.step-forward; label: I18n.t("previewPane.nextFrame"); repeats: true; clicked => { Editor.step-frames(1); } }
        RoundButton { size: 40px; glyph: Glyph.undo; label: I18n.t("phone.undo"); enabled: Editor.can-undo; clicked => { Editor.undo(); } }
        RoundButton { size: 40px; glyph: Glyph.redo; label: I18n.t("phone.redo"); enabled: Editor.can-redo; clicked => { Editor.redo(); } }
        RoundButton { size: 40px; glyph: Glyph.fit; label: I18n.t("mobile.fullscreen"); clicked => { root.fullscreen(); } }
    }
}
export component FullscreenPlayer inherits Rectangle {
    in property <string> project-name;
    callback closed();
    property <bool> controls: true;
    property <int> interaction;
    changed interaction => { idle.running = false; idle.running = true; }
    idle := Timer { interval: 2500ms; running: true; triggered => { root.controls = false; } }


        background: #000;
        TouchArea { clicked => { root.controls = !root.controls; root.interaction += 1; } }
        Image { width: parent.width; height: parent.height; source: Editor.preview-frame; image-fit: contain; }
        if !Editor.has-picture: Text { text: I18n.t("mobile.noPreview"); color: #fff; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle {
            visible: root.controls;
            x: 0; y: 0; width: parent.width; height: 48px; background: #00000088;
            HorizontalLayout {
                padding-left: 8px; padding-right: 16px; spacing: 12px;
                VerticalLayout { alignment: center; RoundButton { foreground: #fff; glyph: Glyph.chevron-left; label: I18n.t("mobile.exitFullscreen"); clicked => { root.closed(); } } }
                Text { text: root.project-name; color: #fff; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            }
        }
        Rectangle {
            visible: root.controls;
            y: parent.height - self.height; width: parent.width; height: 76px; background: #000000aa;
            Rectangle {
                x: 24px; y: 4px; width: parent.width - 48px; height: 24px;
                Rectangle { y: 10px; width: parent.width; height: 4px; border-radius: 2px; background: #ffffff44; }
                Rectangle { x: 0; y: 10px; width: parent.width * Math.clamp(Editor.playhead / Math.max(0.01, Editor.preview-duration), 0, 1); height: 4px; border-radius: 2px; background: Theme.accent; }
                TouchArea {
                    clicked => { root.interaction += 1; Editor.seek(Math.clamp(self.mouse-x / self.width, 0, 1) * Editor.preview-duration); }
                    moved => { if (self.pressed) { root.interaction += 1; Editor.seek(Math.clamp(self.mouse-x / self.width, 0, 1) * Editor.preview-duration); } }
                }
            }
            HorizontalLayout {
                y: 30px; height: 44px; width: parent.width; alignment: center; spacing: 18px;
                RoundButton { foreground: #fff; glyph: Glyph.step-back; label: I18n.t("previewPane.previousFrame"); size: 40px; repeats: true; clicked => { root.interaction += 1; Editor.step-frames(-1); } }
                RoundButton { foreground: #fff; glyph: Editor.playing ? Glyph.pause : Glyph.play; label: Editor.playing ? I18n.t("previewPane.pause") : I18n.t("previewPane.play"); size: 44px; accent: true; clicked => { root.interaction += 1; Editor.play-toggled(); } }
                RoundButton { foreground: #fff; glyph: Glyph.step-forward; label: I18n.t("previewPane.nextFrame"); size: 40px; repeats: true; clicked => { root.interaction += 1; Editor.step-frames(1); } }
            }
            Text { x: 20px; y: 45px; text: Fmt.short-duration(Editor.playhead); color: #fff; font-size: 12px; }
            Text { x: parent.width - self.width - 20px; y: 45px; text: Fmt.short-duration(Editor.preview-duration); color: #fff; font-size: 12px; }
        }
    
}
