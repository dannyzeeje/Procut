// The editor as a phone shows it: one screen, held upright, driven by a
// finger. Shown in place of the title strip and the dock wherever the
// window is a phone's - see `App.phone` and `platform::phone` - and never
// beside them: the desk's layout is the desk's, and this one is not a
// squeezed copy of it but the shape every phone editor has arrived at,
// because a thumb and a portrait screen leave no other.
//
// Top to bottom:
//
//   - a bar with the way out, the project's name, Settings and Export;
//   - the monitor, which takes whatever height the rest leaves;
//   - the transport: where the playhead is, a frame back, Play, a frame
//     on, undo and redo;
//   - the lanes, with the playhead held at their middle and the cut
//     sliding under it - a drag scrubs and a throw glides on, two fingers
//     pinch the zoom, a tap on a clip selects it where it is, a tap on
//     empty lane lets go, a clip dragged moves (see `finger` in
//     lanes.slint, `centred` in the timeline pane on the Rust side, and
//     the glide beside it);
//   - the bar of tools. With nothing selected it is the library's pages
//     and the project's verbs; with a clip selected it is the clip's
//     verbs, with a way back at its head.
//
// Every tool that has more to say than a press opens a sheet over the
// lanes and the bar (sheet.slint) holding the same panel the desk shows
// for it - the inspector's page, the library's shelf - so the phone and
// the desk edit through one set of controls and one set of callbacks.
// Everything read and everything reported goes through the Editor global,
// the way the seats do it; there is no phone-only state on the Rust side
// beyond the two facts named above.

/// A grid of the bin's cards for a finger. A tap picks a card or lets it
/// go, and a picked card wears its place in the order - 1, 2, 3 - the way
/// every phone editor's picker numbers them, since that is the order Add
/// lays them down in. Five photos are five taps and an Add, not five trips
/// in and out of the sheet; there is nowhere to drag a card to.
component PhoneMediaGrid inherits Rectangle {
    in property <[MediaItemData]> items;

    callback picked(id: int);
    callback removed(id: int);

    property <length> gap: 8px;
    property <length> min-card: 100px;
    property <int> cols: Math.max(1,
        Math.floor((root.width + root.gap) / (root.min-card + root.gap)));
    property <length> card-w: (root.width - (root.cols - 1) * root.gap) / root.cols;
    property <length> card-h: root.card-w * 9 / 16 + 4px + 14px;
    property <int> rows: Math.ceil(root.items.length / root.cols);

    height: root.rows > 0 ? root.rows * (root.card-h + root.gap) - root.gap : 0px;

    for entry[index] in root.items: MediaCard {
        x: Math.mod(index, root.cols) * (root.card-w + root.gap);
        y: Math.floor(index / root.cols) * (root.card-h + root.gap);
        width: root.card-w;
        height: root.card-h;
        item: entry;
        removable: true;
        touch-controls: true;
        removed => { root.removed(entry.id); }

        // A second tap toggles back; a double tap is two taps, not a third
        // thing.
        clicked(additive) => { root.picked(entry.id); }
    }

    // The pick's mark, over the picture's corner. Draws only: the card under
    // it takes the tap. Empty for a card not picked, so it reads as
    // something to tap.
    for entry[index] in root.items: Rectangle {
        x: Math.mod(index, root.cols) * (root.card-w + root.gap) + 6px;
        y: Math.floor(index / root.cols) * (root.card-h + root.gap) + 6px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: entry.pick > 0 ? Theme.accent : #00000059;
        border-width: entry.pick > 0 ? 0px : 1.5px;
        border-color: #ffffffd9;

        if entry.pick > 0: Text {
            text: entry.pick;
            color: Theme.on-accent;
            font-size: Theme.fs-sm;
            font-weight: Theme.weight-title;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// A worded button the width of its sheet: Import, Add a title, Modify.
component SheetButton inherits Rectangle {
    in property <string> label;
    in property <Glyph> glyph;
    in property <bool> primary;
    in property <bool> enabled: true;

    callback clicked();

    height: 44px;
    border-radius: Theme.r;
    opacity: root.enabled ? 1.0 : 0.5;
    background: root.primary
        ? (touch.pressed ? Theme.accent-hover : Theme.accent)
        : (touch.pressed ? Theme.field-active : Theme.field);

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 16px;
        padding-right: 16px;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 16px;
                tint: root.primary ? Theme.on-accent : Theme.fg;
            }
        }

        Text {
            text: root.label;
            min-width: 0px; overflow: elide;
            color: root.primary ? Theme.on-accent : Theme.fg;
            font-size: Theme.fs-lg;
            font-weight: Theme.weight-title;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// A line of quiet words in a sheet: what a page is for, or why it is
/// empty.
component SheetNote inherits Text {
    color: Theme.fg-dim;
    font-size: Theme.fs;
    wrap: word-wrap;
}

/// The phone's Mask: the shapes as a row of tiles to thumb along, the way
/// every phone editor lays them out, and under it the numbers a finger
/// cannot drag on the monitor - the softness, the turn, a rectangle's
/// corners - and the invert. Where and how big is dragged on the monitor
/// with the grips the stage draws; the sliders for those are the desk's.
component PhoneMaskPanel inherits VerticalLayout {
    in property <SelectedClipData> selected;

    callback set(field: ClipField, value: float);
    callback commit();

    property <int> mask: root.selected.mask;
    property <float> feather: root.selected.mask-feather;
    property <float> turn: root.selected.mask-rotation;
    property <float> roundness: root.selected.mask-roundness;

    // A shape reshapes the current mask, or puts one on; None takes the
    // current one off.
    function pick(index: int) {
        if (index < 0) {
            root.set(ClipField.mask-remove, 0);
        } else {
            root.set(ClipField.mask-shape, index);
        }
        root.commit();
    }

    spacing: 6px;

    ToolStrip {
        height: 74px;
        ToolItem {
            glyph: Glyph.close;
            label: I18n.t("common.none");
            current: root.mask < 0;
            clicked => { root.pick(-1); }
        }
        ToolItem {
            glyph: Glyph.mask-linear;
            label: I18n.t("mask.linear");
            current: root.mask == 0;
            clicked => { root.pick(0); }
        }
        ToolItem {
            glyph: Glyph.mask-mirror;
            label: I18n.t("mask.mirror");
            current: root.mask == 1;
            clicked => { root.pick(1); }
        }
        ToolItem {
            glyph: Glyph.mask-circle;
            label: I18n.t("mask.circle");
            current: root.mask == 2;
            clicked => { root.pick(2); }
        }
        ToolItem {
            glyph: Glyph.mask-rectangle;
            label: I18n.t("mask.rectangle");
            current: root.mask == 3;
            clicked => { root.pick(3); }
        }
        ToolItem {
            glyph: Glyph.mask-heart;
            label: I18n.t("mask.heart");
            current: root.mask == 4;
            clicked => { root.pick(4); }
        }
        ToolItem {
            glyph: Glyph.mask-star;
            label: I18n.t("mask.star");
            current: root.mask == 5;
            clicked => { root.pick(5); }
        }
    }

    if root.mask < 0: SheetNote {
        text: I18n.t("mask.phoneHint");
    }

    if root.mask >= 0: SheetNote {
        text: I18n.t("mask.phoneDrag");
    }

    if root.mask >= 0: SwitchRow {
        label: I18n.t("mask.invert");
        checked: root.selected.mask-invert;
        toggled(on) => { root.set(ClipField.mask-invert, on ? 1 : 0); root.commit(); }
    }

    if root.mask >= 0: Param {
        label: I18n.t("clipInspector.feather");
        keyable: true;
        field: ClipField.mask-feather;
        value <=> root.feather;
        minimum: 0;
        maximum: 1;
        step: 0.01;
        default-value: 0;
        fmt: ParamFormat.fraction;
        unit: "%";
        unit-scale: 100;
        changed(v) => { root.set(ClipField.mask-feather, v); root.commit(); }
    }

    if root.mask >= 0: Param {
        label: I18n.t("common.rotation");
        keyable: true;
        field: ClipField.mask-rotation;
        value <=> root.turn;
        minimum: -180;
        maximum: 180;
        step: 1;
        default-value: 0;
        fmt: ParamFormat.degrees;
        unit: "°";
        changed(v) => { root.set(ClipField.mask-rotation, v); root.commit(); }
    }

    if root.mask == 3: Param {
        label: I18n.t("mask.roundness");
        keyable: true;
        field: ClipField.mask-roundness;
        value <=> root.roundness;
        minimum: 0;
        maximum: 1;
        step: 0.01;
        default-value: 0;
        fmt: ParamFormat.fraction;
        unit: "%";
        unit-scale: 100;
        changed(v) => { root.set(ClipField.mask-roundness, v); root.commit(); }
    }
}

/// One of the project's facts: the label, then the value against the
/// trailing edge.
component Fact inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 12px;
    min-height: 30px;

    Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        vertical-alignment: center;
    }

    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.fg;
        font-family: Theme.font-technical;
        font-size: Theme.fs;
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

/// A round chip over the lanes: the zoom, for a thumb that has no second
/// finger free to pinch with.
component LaneChip inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> label;

    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: touch.pressed ? Theme.field-active : Theme.raised;
    border-width: 1px;
    border-color: Theme.line-strong;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 14px;
        tint: Theme.fg;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Whether a sheet is up in the phone editor, and a way to ask it down:
/// Android's Back, which the window hears, closes it before it leaves the
/// project - with Effects open, Back saved and went back to the projects.
export global PhoneSheets {
    in-out property <bool> open;
    in-out property <int> close-asked;
}

export component PhoneEditor inherits Rectangle {
    in property <string> project-name;
    /// "saved", "saving…": the little truth under the name.
    in property <string> status;

    callback export-clicked();
    callback open-settings();
    /// Back to the launch screen; the window saves on the way.
    callback close-project();

    /// Which sheet is up, by name, or empty for none. The names are the
    /// library's pages - "media", "text", "effects", "filters",
    /// "adjustments", "transitions" - the project's own, and a "clip-" page
    /// of the inspector for the selected clip.
    property <string> sheet;
    property <int> track-index: 0;
    property <length> sidebar-width: 56px;
    // Back closes the sheet on top before it leaves the editor; the window
    // hears the key, so the sheet's state is told it through PhoneSheets.
    property <bool> handles-back: root.sheet != "" || root.workspace-mode != 0;
    changed handles-back => { PhoneSheets.open = root.handles-back; }
    property <int> close-asked: PhoneSheets.close-asked;
    changed close-asked => {
        if (root.sheet != "") { Editor.blur(); root.hide(); }
        else if (root.workspace-mode != 0) { root.switch-workspace(0); }
    }
    /// The Audio sheet's shelf: 0 my sounds, 1 voices, 2 styles.
    property <int> audio-shelf;
    /// Kept for the shared picker callback; phone imports use the playhead.
    property <bool> media-at-end;
    /// The sheet up is one of the clip's, and goes with the clip.
    property <bool> sheet-needs-clip;

    property <bool> multi-select;
    property <int> workspace-mode;
    property <bool> color-mode: root.workspace-mode == 1;
    property <bool> audio-mode: root.workspace-mode == 2;
    property <bool> audio-preview: true;
    property <bool> audio-region;
    property <bool> audio-point-dragging;
    changed sheet => { root.audio-point-dragging = false; }
    property <float> region-start: -1;
    property <bool> audio-source: root.has-clip && !root.batch-selection && Editor.selected-clip.has-sound;
    property <bool> editable-audio: root.audio-source || (root.has-clip && !root.batch-selection && root.kind == ClipKind.sound-layer);
    init => { Editor.phone-color-active = false; }
    property <bool> before-grade;
    property <bool> expanded-tool;
    property <string> color-parameter: "exposure";
    property <int> crop-side;
    property <[string]> crop-labels: [
        I18n.t("common.left"), I18n.t("common.top"), I18n.t("common.right"), I18n.t("common.bottom")
    ];
    property <string> grading-target: Editor.primary-selected-id;
    property <bool> can-grade: Editor.phone-can-grade;
    changed grading-target => { root.before-grade = false; }
    changed can-grade => { if (!root.can-grade) { root.before-grade = false; } }

    function compare-grade(before: bool) {
        root.before-grade = before;
        Editor.phone-color-compare(before);
    }
    function switch-workspace(mode: int) {
        if (root.workspace-mode == mode) { return; }
        Editor.blur();
        root.hide();
        root.before-grade = false;
        root.workspace-mode = mode;
        root.region-start = -1;
        root.audio-region = false;
        Editor.phone-color-active = root.color-mode;
        Editor.phone-workspace-changed(root.audio-mode);
    }
    property <bool> editing-clips: Editor.selected-count > 0;
    property <bool> batch-selection: Editor.selected-count > 1;
    property <bool> has-clip: Editor.selected-clip.present;
    property <ClipKind> kind: Editor.selected-clip.kind;
    property <bool> is-video: !Editor.selected-clip.batch-volume && root.kind == ClipKind.video;
    property <bool> is-audio: Editor.selected-clip.batch-volume || root.kind == ClipKind.audio || root.kind == ClipKind.sound-layer;
    property <bool> is-image: root.kind == ClipKind.image;
    property <bool> is-text: root.kind == ClipKind.text;
    property <bool> is-layer: root.kind == ClipKind.filter || root.kind == ClipKind.effect
        || root.kind == ClipKind.adjustment || root.kind == ClipKind.transition;
    /// A shape has a placement and nothing else a picture has: no colour
    /// to adjust, no chain, no transition, no frame to freeze.
    property <bool> is-shape: root.kind == ClipKind.shape;
    /// A picture: what has a placement, a colour and a chain of effects.
    property <bool> is-picture: root.is-video || root.is-image;

    // A clip's sheet closes with the clip - deleted, or let go of by a tap
    // on the floor - rather than staying up over a selection it no longer
    // describes.
    property <int> selected-count: Editor.selected-count;
    changed selected-count => {
        if (root.selected-count != 1 && root.sheet-needs-clip) {
            root.hide();
        }
    }

    function show(name: string, needs-clip: bool) {
        root.expanded-tool = false;
        Editor.effect-preview-finish(false);
        root.sheet = name;
        root.sheet-needs-clip = needs-clip;
        if (name == "clip-animate") { Editor.effect-preview("animation", "", ""); }
    }
    function activate-tool(id: string) {
        if (id == "media") { root.show-media(false); }
        else if (id == "delete") { Editor.delete-selected(); }
        else if (id == "split") { Editor.shortcut("split-selected"); }
        else if (id == "duplicate" || id == "freeze" || id == "reverse" || id == "mirror" || id == "rotate") { Editor.shortcut(id); }
        else if (id == "captions") { Editor.captions(); }
        else if (id == "speak") { Editor.speak(); }
        else if (id == "replace") { Editor.replace-clip-media(); }
        else if (id == "voiceover") { root.hide(); Editor.record-voiceover(); }
        else if (id == "edit") { root.show(root.is-audio ? "clip-audio" : root.is-text ? "clip-text" : root.is-shape ? "clip-shape" : root.is-layer ? "clip-layer" : "clip-video", true); }
        else { root.show(id, root.has-clip); }
    }
    function set-fullscreen(on: bool) { Editor.preview-fullscreen = on; Editor.preview-fullscreen-changed(on); }
    function hide() {
        Editor.effect-preview-finish(false);
        root.sheet = "";
        root.sheet-needs-clip = false;
        root.expanded-tool = false;
    }
    /// The bin, with nothing picked yet.
    function show-media(at-end: bool) {
        Editor.media-clear-picks();
        root.media-at-end = false;
        root.show("media", false);
    }

    pure function sheet-title(name: string) -> string {
        return name == "customize-tools" ? I18n.t("mobile.customizeTools")
            : name == "track-controls" ? I18n.t("atlas.trackControls")
            : name == "tools" ? I18n.t("mobile.allTools")
            : name == "media" ? I18n.t("common.media")
            : name == "audio" ? I18n.t("common.audio")
            : name == "text" || name == "clip-text" ? I18n.t("common.text")
            : name == "clip-shape" ? I18n.t("shapePanel.shape")
            : name == "effects" || name == "clip-effects" ? I18n.t("common.effects")
            : name == "filters" ? I18n.t("mediaPane.filters")
            : name == "adjustments" ? I18n.t("mediaPane.adjustments")
            : name == "transitions" ? I18n.t("mediaPane.transitions")
            : name == "project" ? I18n.t("phone.project")
            : name == "canvas" || name == "clip-canvas" ? I18n.t("phone.canvas")
            : name == "clip-video" ? I18n.t("phone.edit")
            : name == "clip-crop" ? I18n.t("clipInspector.crop")
            : name == "clip-trim" ? I18n.t("mobile.trim")
            : name == "clip-speed" ? I18n.t("common.speed")
            : name == "clip-audio" ? I18n.t("common.audio")
            : name == "clip-audio-effects" ? I18n.t("configPane.audioEffects")
            : name == "color-input" ? I18n.t("mobile.colorInput")
            : name == "grade-layers" ? I18n.t("mobile.gradeLayers")
            : name == "clip-luts" ? I18n.t("mediaPane.luts")
            : name == "audio-mixer" ? I18n.t("mobile.mixer")
            : name == "audio-graph" ? I18n.t("mobile.volumeGraph")
            : name == "audio-filters" ? I18n.t("configPane.audioEffects")
            : name == "clip-adjust" ? I18n.t("common.adjust")
            : name == "clip-enhance" ? I18n.t("common.enhance")
            : name == "clip-layer" ? I18n.t("configPane.filter")
            : name == "clip-mask" ? I18n.t("mask.title")
            : name == "clip-animate" ? I18n.t("motion.animate")
            : "";
    }

    background: Theme.page;

    // Placed rather than laid out. The lanes take a share of the screen's
    // height, and a layout that read the height of the thing it is sizing
    // is a binding loop - the launch screen has the same note. Five rows,
    // each at a height of its own: the bar and the lanes are measured up
    // from the foot, the top bar and the transport down from the head, and
    // the monitor is what is left between.
    property <length> top-h: 48px;
    property <length> workspace-h: 54px;
    property <length> preview-top: root.top-h;
    property <length> workspace-y: root.height - root.workspace-h;
    property <length> tools-y: root.workspace-y - root.bar-h;
    property <length> transport-h: 96px;
    /// A resizable timeline with room for the preview.
    property <float> timeline-share: 0.42;
    property <float> audio-timeline-share: 0.57;
    property <length> lanes-h: Math.max(160px, Math.min(
        root.workspace-y - root.preview-top - root.transport-h - root.bar-h - root.timeline-gap
            - (root.audio-mode && !root.audio-preview ? 0px : 110px),
        root.audio-mode && !root.audio-preview ? root.height
            : root.height * (root.audio-mode ? root.audio-timeline-share : root.timeline-share)));
    property <length> bar-h: 74px;
    property <length> lanes-y: root.tools-y - root.lanes-h;
    property <length> timeline-gap: 20px;
    property <length> transport-y: root.lanes-y - root.transport-h - root.timeline-gap;
    property <length> color-panel-h: 314px;
    property <length> display-transport-y: root.color-mode
        ? Math.max(root.preview-top + 72px, root.workspace-y - root.color-panel-h - root.transport-h)
        : root.transport-y;
    property <bool> quick-sheet: root.sheet == "clip-speed" || root.sheet == "clip-audio" || root.sheet == "clip-trim";
    property <length> sheet-h: root.quick-sheet
        ? (root.expanded-tool ? root.height * 0.7 : Math.min(root.height * 0.52, 346px))
        : root.sheet == "audio-graph" ? Math.min(root.height * 0.72, 545px)
        : root.height * 0.5;
    property <bool> show-motion-status: root.sheet == "" && !Editor.preview-fullscreen && Editor.motion-status != "";
    property <length> monitor-foot: root.sheet != ""
        ? Math.min(root.display-transport-y, root.height - root.sheet-h)
        : root.display-transport-y;
    /// The Add bar under the bin while something is picked.
    property <length> add-bar-h: 68px;

    // Fixed side slots keep the project name centred at every width.
    Rectangle {
        x: 0px; y: 0px;
        width: root.width; height: root.top-h;
        RoundButton { x: 12px; y: 2px; glyph: Glyph.chevron-left; label: I18n.t("studio.closeProject"); clicked => { root.switch-workspace(0); root.hide(); root.close-project(); } }
        RoundButton { x: 56px; y: 2px; glyph: Glyph.more; label: I18n.t("mobile.menu"); clicked => { root.hide(); project-menu.open-state = !project-menu.open-state; } }
        Text { x: 96px; width: Math.max(0px, parent.width - 192px); height: parent.height; text: root.project-name; color: Theme.fg; font-size: Theme.fs-lg; font-weight: Theme.weight-title; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        RoundButton { x: parent.width - 56px; y: 2px; glyph: Glyph.export; accent: true; corner-radius: 13px; label: I18n.t("common.export"); clicked => { root.hide(); root.export-clicked(); } }
    }

    HorizontalLayout {
        x: 12px; y: root.workspace-y; width: root.width - 24px; height: root.workspace-h;
        padding-top: 3px; padding-bottom: 3px; spacing: 6px;
        PhoneCommand { label: I18n.t("phone.edit"); selected: root.workspace-mode == 0; clicked => { root.switch-workspace(0); } }
        PhoneCommand { label: I18n.t("common.color"); selected: root.color-mode; clicked => { root.switch-workspace(1); } }
        PhoneCommand { label: I18n.t("common.audio"); selected: root.audio-mode; clicked => { root.switch-workspace(2); } }
    }

    // ── the monitor ──────────────────────────────────────────────────
    //
    // The pane's stage alone, with 8px of the ground either side so it
    // reads as a card on the page like the lanes under it. The stage
    // keeps its gestures: a drag on the picture moves the selected clip. The fitted viewport stays fixed.
    Rectangle {
        visible: !Editor.preview-fullscreen && (!root.audio-mode || root.audio-preview);
        x: 0;
        y: root.preview-top;
        width: root.width;
        height: Math.max(0px, root.monitor-foot - root.preview-top);

        monitor := PreviewPane {
            x: 8px;
            y: 0;
            width: parent.width - 16px;
            height: parent.height;
            bare: true;
            view-gestures: false;

            output-width: Editor.output-width;
            output-height: Editor.output-height;
            frame-rate: Editor.frame-rate;
            ratio-index: Editor.ratio-index;
            quality-index: Editor.quality-index;
            playhead: Editor.playhead;
            duration: Editor.preview-duration;
            playhead-free: Editor.playhead-free;
            playing: Editor.playing;
            has-picture: Editor.has-picture;
            clip-name: Editor.preview-clip-name;
            frame: Editor.preview-frame;
            see-through: Editor.see-through;
            stage-items: root.workspace-mode == 0 ? Editor.stage-items : [];
            crop-editing: root.sheet == "clip-crop";
            touch-grips: true;
            stage-guides: Editor.stage-guides;
            stroke-path: Editor.stroke-path;
            stroke-width: Editor.stroke-width;
            stroke-erase: Editor.stroke-erase;
            painting: Editor.painting && Editor.selected-clip.cutout == 2;
            picking: Editor.picking-colour;

            play-toggled => { Editor.play-toggled(); }
            seek(seconds) => { Editor.seek(seconds); }
            step(frames) => { Editor.step-frames(frames); }
            ratio-changed(index) => { Editor.ratio-changed(index); }
            quality-changed(index) => { Editor.quality-changed(index); }
            stage-pressed(x, y, additive) => {
                Editor.blur();
                if (root.workspace-mode == 0 && root.sheet != "clip-crop") {
                    let target = Editor.primary-selected-id;
                    Editor.stage-pressed(x, y, additive);
                    if (root.sheet-needs-clip && target != Editor.primary-selected-id) { root.hide(); }
                }
            }
            stage-grip-pressed(id, grip, x, y) => {
                Editor.blur();
                Editor.stage-grip-pressed(id, grip, x, y);
            }
            stage-dragged(x, y, snap) => { Editor.stage-dragged(x, y, snap); }
            stage-released => { Editor.stage-released(); }
        }
    }

    // ── the transport ────────────────────────────────────────────────
    //
    // Where the playhead is on the leading edge, the view's way back
    // and the history's two steps on the trailing one, and Play in the
    // middle of the row with a frame back and a frame on either side of
    // it - placed against the whole row rather than laid out, so they
    // stay under the thumb whatever the timecode's width. Measured for a
    // 360px screen, the narrowest phone in common use: the middle three
    // and the trailing three meet with a few pixels to spare.
    //
    // The frame steps are for the cut a drag cannot land on: a finger
    // lifting off the glass nudges the lanes a little, and a frame is a
    // pixel or less at most zooms (#244). Held, they keep stepping.
    if root.show-motion-status: Text {
        x: 12px; y: root.display-transport-y - 24px; width: root.width - 24px; height: 24px;
        text: Editor.motion-status; color: Theme.fg; font-size: Theme.fs-sm;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }

    property <int> frames: Math.round(Math.max(0, Editor.playhead) * Editor.frame-rate);
    property <int> rate: Math.max(1, Math.round(Editor.frame-rate));

    PhoneTransport {
        x: 0; y: root.display-transport-y; width: root.width; height: root.transport-h;
        fullscreen => { root.hide(); root.set-fullscreen(true); }
    }

    // ── the lanes ────────────────────────────────────────────────────
    //
    // Keep track switches aligned with the scrolling lanes.
    stack := Rectangle {
        visible: !root.color-mode;
        x: 0;
        y: root.lanes-y;
        width: root.width;
        height: root.lanes-h;

        // The stack scrolls here rather than in Rust, as it does in the
        // timeline pane and for the same reason: it is a property of
        // looking at the lanes, not of the edit. Measured up from the
        // foot, where the main lane is: a phone editor's main track is the row
        // always in view, with the overlays stacked above it, and a stack
        // read from its head left the main lane - the video, and every
        // picture added to it - below the card once there were four lanes.
        // Clamped on read, so a stack that gets shorter cannot leave the
        // view parked past its end.
        property <length> lift;
        property <length> stack-h: Editor.tracks.length > 0
            ? Editor.tracks[Editor.tracks.length - 1].top
                + Editor.tracks[Editor.tracks.length - 1].height
            : 0px;
        property <length> overflow: Math.max(0px,
            self.stack-h - Math.max(0px, lanes.height - lanes.ruler-height));
        property <length> at: Math.max(0px, self.overflow - Math.min(self.overflow, self.lift));

        Rectangle {
            x: 8px;
            y: 0;
            width: parent.width - 16px;
            height: parent.height;
            background: Theme.panel;
            border-radius: Theme.r-lg;
            clip: true;

            PhoneTrackHeaders {
                x: 0; y: 44px; width: root.sidebar-width; height: parent.height - 44px;
                visible: true;
                tracks: Editor.tracks; track-scroll: stack.at;
                selected(index) => { root.track-index = index; root.show("track-controls", false); }
                scrolled(pixels) => { stack.lift = Math.clamp(stack.overflow - stack.at - pixels, 0px, stack.overflow); }
            }
            lanes := Lanes {
                x: root.sidebar-width;
                y: 44px;
                width: parent.width - root.sidebar-width;
                height: parent.height - 44px;

                finger: true;
                duration-seconds: Editor.duration-seconds;
                edge-grab: 14px;
                ruler-height: 32px;
                track-scroll: stack.at;

                tracks: Editor.tracks;
                clips: Editor.clips;
                key-marks: Editor.key-marks;
                tool: Editor.tool;
                playhead: Editor.playhead;
                frame-rate: Editor.frame-rate;
                scroll-left: Editor.scroll-left;
                seconds-per-pixel: Editor.seconds-per-pixel;
                pan-mode: false;
                preview-axis: false;
                drop: Editor.drop;
                menu-items: Editor.menu-items;
                menu-height: Editor.menu-height;
                menu-token: Editor.menu-token;

                scrubbed(seconds) => {
                    Editor.blur();
                    Editor.scrubbed(seconds);
                }
                finger-held => { Editor.finger-held(); }
                finger-lifted => { Editor.finger-lifted(); }
                key-mark-moved(from, to) => { Editor.key-mark-moved(from, to); }
                key-mark-opened => { Editor.key-mark-opened(); }
                hovered(seconds) => { Editor.hovered(seconds); }
                hover-ended => { Editor.hover-ended(); }
                floor-pressed => { Editor.blur(); if (!root.multi-select && root.editing-clips) { Editor.shortcut("deselect"); } }
                clip-pressed(id, additive, edge) => {
                    Editor.blur();
                    Editor.clip-pressed(id, additive || root.multi-select, root.multi-select ? -3 : edge);
                }
                clip-dragged(seconds, pixels) => { Editor.clip-dragged(seconds, pixels); }
                clip-released => { Editor.clip-released(); }
                context-enabled: !root.batch-selection && !root.multi-select;
                clip-context(id) => { Editor.clip-context(id); }
                menu-selected(id) => { Editor.menu-selected(id); }
                band-selected(a, b, c, d, additive) => {
                    Editor.band-selected(a, b, c, d, additive);
                }
                scrolled(seconds) => { Editor.scrolled(seconds); }
                track-scrolled(pixels) => {
                    stack.lift = Math.max(0px,
                        Math.min(stack.overflow, stack.overflow - stack.at - pixels));
                }
                zoomed(factor, anchor) => { Editor.zoom(factor, anchor); }
                drag-hovered(payload, seconds, row) => {
                    Editor.drag-hovered(payload, seconds, row);
                }
                dropped(payload, seconds, row) => { Editor.dropped(payload, seconds, row); }
                // How wide the lanes are decides which clips Rust sends,
                // and where their middle is.
                changed width => { Editor.lanes-resized(self.width / 1px); }
                init => { Editor.lanes-resized(self.width / 1px); }
            }

            // An empty cut says where to start. Takes no presses, so the
            // lanes under it still do.
            if Editor.clips.length == 0: Text {
                x: root.sidebar-width + 12px;
                y: 44px + lanes.ruler-height + 14px;
                width: parent.width - root.sidebar-width - 24px;
                text: I18n.t("phone.emptyLanes");
                color: Theme.fg-dim;
                font-size: Theme.fs;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                x: 0; y: 0; width: parent.width; height: 44px; background: Theme.panel;
                HorizontalLayout {
                    padding-left: 2px; padding-right: 2px; spacing: 0px;
                    Rectangle {
                        horizontal-stretch: 1; min-width: 0px;
                        Text {
                            text: I18n.t("atlas.timeline");
                            visible: !root.multi-select && !root.batch-selection && parent.width >= 64px;
                            x: 8px; width: Math.max(0px, parent.width - 12px); height: parent.height;
                            color: Theme.fg; font-size: 13px; font-weight: 600;
                            overflow: elide; vertical-alignment: center;
                        }
                        Text {
                            text: I18n.t1("mobile.selectedCount", Editor.selected-count);
                            visible: (root.multi-select || root.batch-selection) && parent.width >= 72px;
                            x: 8px; width: Math.max(0px, parent.width - 12px); height: parent.height;
                            color: Theme.accent; font-size: 12px;
                            overflow: elide; vertical-alignment: center;
                        }
                    }
                    RoundButton {
                        glyph: root.multi-select ? Glyph.check : Glyph.select-clips;
                        label: I18n.t("mobile.selectClips"); size: 38px;
                        foreground: root.multi-select ? Theme.accent : Theme.fg;
                        clicked => { root.multi-select = !root.multi-select; }
                    }
                    if !root.editing-clips: RoundButton { glyph: Glyph.magnet; label: I18n.t("common.snapToEdges"); foreground: Editor.snap ? Theme.accent : Theme.fg; size: 38px; clicked => { Editor.snap-changed(!Editor.snap); } }
                    if !root.editing-clips: RoundButton { glyph: Glyph.ripple-trim; label: I18n.t("mobile.rippleTrim"); foreground: Editor.magnetic ? Theme.accent : Theme.fg; size: 38px; clicked => { Editor.magnetic-changed(!Editor.magnetic); } }
                    if root.editing-clips && !root.batch-selection: RoundButton {
                        glyph: Glyph.trash; label: I18n.t("common.delete"); size: 38px;
                        enabled: Editor.can-delete-selection;
                        clicked => { Editor.delete-selected(); }
                    }
                    RoundButton { glyph: Glyph.zoom-out; label: I18n.t("common.zoomOut"); size: 38px; clicked => { Editor.zoom(1.4, Editor.playhead); } }
                    RoundButton { glyph: Glyph.zoom-in; label: I18n.t("common.zoomIn"); size: 38px; clicked => { Editor.zoom(1 / 1.4, Editor.playhead); } }
                    RoundButton { glyph: Glyph.plus; label: I18n.t("common.media"); size: 38px; clicked => { root.show-media(false); } }
                }
            }

        }
    }

    Rectangle {
        visible: !root.color-mode;
        x: 0; y: root.lanes-y - root.timeline-gap;
        width: root.width; height: 20px;
        background: Theme.page;
        Rectangle { x: (parent.width - 48px) / 2; y: 7px; width: 48px; height: 4px; border-radius: 2px; background: Theme.fg-muted; }
        TouchArea {
            property <length> origin;
            property <float> initial;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.origin = self.absolute-position.y + self.mouse-y; self.initial = root.audio-mode ? root.audio-timeline-share : root.timeline-share; } }
            moved => { if (self.pressed) {
                let share = Math.clamp(self.initial - (self.absolute-position.y + self.mouse-y - self.origin) / root.height, 0.25, 0.7);
                if (root.audio-mode) { root.audio-timeline-share = share; }
                else { root.timeline-share = share; }
            } }
        }
    }

    function show-clip-actions() {
        Editor.clip-context(Editor.primary-selected-id);
        root.show("tools", true);
    }
    if root.batch-selection && root.workspace-mode == 0: HorizontalLayout {
        x: 0; y: root.tools-y; width: root.width; height: root.bar-h;
        padding-left: 12px; padding-right: 12px; spacing: 0px;
        property <bool> can-merge: Editor.merge-blocked-because == "";
        property <length> slot: (root.width - 24px) / (self.can-merge ? 5 : 4);
        ToolItem { width: parent.slot; glyph: Glyph.check; label: I18n.t("mobile.done"); clicked => { root.multi-select = false; Editor.shortcut("deselect"); } }
        ToolItem { width: parent.slot; glyph: Glyph.copy; label: I18n.t("common.copy"); clicked => { Editor.shortcut("copy"); } }
        ToolItem { width: parent.slot; glyph: Glyph.split; label: I18n.t("phone.split"); enabled: Editor.can-trim-selection; clicked => { Editor.shortcut("split-selected"); } }
        ToolItem { width: parent.slot; glyph: Glyph.trash; label: I18n.t("common.delete"); enabled: Editor.can-delete-selection; clicked => { Editor.delete-selected(); } }
        if Editor.merge-blocked-because == "": ToolItem { width: parent.slot; glyph: Glyph.merge; label: Editor.merge-label; clicked => { Editor.shortcut("merge"); } }
    }
    if root.editing-clips && !root.batch-selection && root.workspace-mode == 0: HorizontalLayout {
        x: 0; y: root.tools-y; width: root.width; height: root.bar-h;
        padding-left: 12px; padding-right: 12px; spacing: 0px;
        property <int> slots: root.is-video ? 6 : root.is-picture ? 5 : 4;
        property <length> slot: (root.width - 24px) / self.slots;
        ToolItem {
            width: parent.slot;
            glyph: root.is-audio ? Glyph.volume : root.is-text ? Glyph.text-mark : Glyph.sliders;
            label: root.is-audio ? I18n.t("common.audio") : root.is-text ? I18n.t("common.text") : I18n.t("phone.edit");
            clicked => { root.activate-tool("edit"); }
        }
        if root.is-picture: ToolItem { width: parent.slot; glyph: Glyph.frame; label: I18n.t("phone.canvas"); clicked => { root.show("clip-canvas", true); } }
        ToolItem { width: parent.slot; glyph: Glyph.split; label: I18n.t("phone.split"); enabled: Editor.can-trim-selection; clicked => { Editor.shortcut("split-selected"); } }
        ToolItem { width: parent.slot; glyph: Glyph.ripple-trim; label: I18n.t("mobile.trim"); enabled: Editor.can-delete-selection; clicked => { root.show("clip-trim", true); } }
        if root.is-video: ToolItem { width: parent.slot; glyph: Glyph.clock; label: I18n.t("common.speed"); clicked => { root.show("clip-speed", true); } }
        ToolItem { width: parent.slot; glyph: Glyph.more; label: I18n.t("phone.more"); clicked => { root.show-clip-actions(); } }
    }
    if !root.editing-clips && root.workspace-mode == 0: ToolStrip {
        y: root.tools-y; width: root.width; height: root.bar-h;
        for tool in Editor.mobile-quick-tools: ToolItem { glyph: tool.glyph; label: tool.label; clicked => { root.activate-tool(tool.id); } }
        ToolItem { glyph: Glyph.more; label: I18n.t("mobile.allTools"); clicked => { root.show("tools", false); } }
    }

    PhoneScroll {
        visible: root.color-mode;
        x: 0; y: root.display-transport-y + root.transport-h;
        width: root.width; height: Math.max(0px, root.workspace-y - self.y);
        gutter: 12px;
        PhoneColorShots {
            height: 54px;
            picked(id) => {
                Editor.blur();
                root.before-grade = false;
                Editor.phone-color-shot(id);
            }
        }
        PhoneColorTools {
            selected-key <=> root.color-parameter;
            before: root.before-grade;
            compare(on) => { root.compare-grade(on); }
            advanced => { root.show("clip-adjust", true); }
        }
        HorizontalLayout {
            spacing: 4px;
            PhoneCommand {
                label: I18n.t("mobile.colorInput");
                enabled: root.can-grade;
                clicked => { root.compare-grade(false); root.show("color-input", true); }
            }
            PhoneCommand {
                label: I18n.t("mobile.gradeLayers");
                enabled: root.can-grade;
                clicked => { root.compare-grade(false); root.show("grade-layers", true); }
            }
            PhoneCommand {
                label: I18n.t("mediaPane.luts");
                clicked => { root.compare-grade(false); root.show("clip-luts", false); }
            }
        }
    }

    if root.audio-mode: HorizontalLayout {
        x: 10px; y: root.tools-y; width: root.width - 20px; height: root.bar-h;
        padding-top: 5px; padding-bottom: 5px; spacing: 4px;
        if !root.audio-region: PhoneCommand {
            label: I18n.t("mobile.mixer");
            clicked => { root.show("audio-mixer", false); }
        }
        if !root.audio-region: PhoneCommand {
            label: I18n.t("mobile.graph");
            enabled: root.audio-source;
            clicked => { root.show("audio-graph", true); }
        }
        if !root.audio-region: PhoneCommand {
            label: I18n.t("mediaPane.filters");
            enabled: root.editable-audio;
            clicked => { root.show("audio-filters", true); }
        }
        if !root.audio-region: PhoneCommand {
            label: I18n.t("mobile.filterRange");
            clicked => { root.audio-region = true; }
        }
        if !root.audio-region: PhoneCommand {
            label: I18n.t("common.preview");
            selected: root.audio-preview;
            clicked => { root.audio-preview = !root.audio-preview; }
        }
        if root.audio-region: PhoneCommand {
            label: I18n.t("mobile.markIn");
            selected: root.region-start >= 0;
            enabled: Editor.playhead < Editor.preview-duration;
            clicked => { root.region-start = Editor.playhead; }
        }
        if root.audio-region: PhoneCommand {
            label: I18n.t("mobile.applyLowPass");
            enabled: root.region-start >= 0 && Editor.playhead - root.region-start >= 0.5 / Math.max(1, Editor.frame-rate);
            clicked => {
                Editor.phone-low-pass-region(root.region-start, Editor.playhead);
                root.audio-region = false;
                root.region-start = -1;
                if (root.kind == ClipKind.sound-layer) { root.show("audio-filters", true); }
            }
        }
        if root.audio-region: PhoneCommand {
            label: I18n.t("common.cancel");
            clicked => { root.audio-region = false; root.region-start = -1; }
        }
    }

    // ── the sheet ────────────────────────────────────────────────────────
    //
    // One sheet, one body, chosen by name. Each page is the desk's own
    // panel bound to the Editor global the way the seats bind it; the
    // library's pages close themselves once something is placed, so what
    // was placed is seen, and the inspector's stay up to be worked in.
    sheet := PhoneSheet {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        sheet-height: root.sheet-h;
        scroll-enabled: !root.audio-point-dragging;
        dismiss-on-background: !root.quick-sheet && root.sheet != "clip-text" && root.sheet != "clip-mask" && root.sheet != "clip-crop";
        footer: root.sheet != "audio-graph" && root.sheet != "media" && root.sheet != "tools" && root.sheet != "customize-tools" && !Editor.effect-preview-active;
        preview-footer: Editor.effect-preview-active;
        open: root.sheet != "";
        title: root.sheet-title(root.sheet);
        closed => { Editor.blur(); root.hide(); }

        if root.sheet == "color-input" && root.can-grade: PhoneCameraInput {}
        if root.sheet == "grade-layers" && root.can-grade: PhoneGradeLayers {}
        if root.sheet == "audio-mixer": PhoneMixer {}
        if root.sheet == "audio-graph" && root.audio-source: PhoneVolumeGraph {
            point-dragging(active) => { root.audio-point-dragging = active; }
        }
        if root.sheet == "audio-filters" && root.editable-audio: PhoneAudioFilters {
            source: root.audio-source;
            edit-fades => { root.show("clip-audio", true); root.expanded-tool = true; }
            more-effects => { root.show("clip-audio-effects", true); }
        }
        if root.sheet == "clip-luts": VerticalLayout {
            padding: 12px;
            spacing: 8px;
            SheetButton {
                glyph: Glyph.import;
                label: I18n.t("mediaPane.importALut");
                clicked => { Editor.library-import-lut(); }
            }
            if Editor.catalogue-luts.length == 0: SheetNote { text: I18n.t("mediaPane.noLutsYet"); }
            if !root.can-grade: SheetNote { text: I18n.t("mobile.selectShot"); }
            for lut in Editor.catalogue-luts: VerticalLayout {
                if !root.can-grade: PhoneCommand { label: lut.name; enabled: false; }
            }
            if root.can-grade: ShelfGrid {
                entries: Editor.catalogue-luts;
                glyph: Glyph.sun;
                auditions: false;
                applied(id, label) => { Editor.library-apply-lut(id, label); root.show("grade-layers", true); }
            }
        }

        // ── the bin ──
        if root.sheet == "media": VerticalLayout {
            padding: 12px;
            spacing: 12px;

            SheetButton {
                glyph: Glyph.import;
                primary: true;
                enabled: !Editor.importing;
                label: Editor.importing ? I18n.t("mediaPane.importing") : I18n.t("phone.importMedia");
                clicked => { Editor.import-media(); }
            }
            SheetNote {
                text: Editor.media.length == 0 ? I18n.t("phone.noMediaYet")
                    : root.media-at-end ? I18n.t("phone.pickToAddAtEnd")
                    : I18n.t("phone.pickToAdd");
            }
            if Editor.media-selected-count > 0: SheetButton {
                glyph: Glyph.trash;
                label: I18n.t("common.delete");
                clicked => { Editor.media-remove-selected(); }
            }
            Select {
                options: [I18n.t("mediaPane.sortAdded"), I18n.t("mediaPane.sortName"), I18n.t("mediaPane.sortType")];
                changed(index) => { Editor.media-sort-changed(index); }
            }
            PhoneMediaGrid {
                items: Editor.media;
                picked(id) => { Editor.media-select(id, true); }
                removed(id) => { Editor.media-remove(id); }
            }
            // Room under the last row for the Add bar over it.
            if Editor.media-selected-count > 0: Rectangle {
                height: root.add-bar-h - 12px;
            }
        }

        // ── the user's own sounds: brought in from the phone's files,
        // played with a tap, laid at the playhead with the plus ──
        if root.sheet == "audio": VerticalLayout {
            padding: 12px;
            spacing: 12px;

            // Three shelves, as chips across the top: the user's sounds,
            // the voices, the styles.
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for shelf[index] in [I18n.t("sounds.mine"), I18n.t("voices.voices"), I18n.t("voices.styles")]: Rectangle {
                    height: 32px;
                    width: chip-text.preferred-width + 28px;
                    border-radius: 16px;
                    background: root.audio-shelf == index ? Theme.accent : Theme.field;
                    chip-text := Text {
                        text: shelf;
                        color: root.audio-shelf == index ? Theme.on-accent : Theme.fg-muted;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    TouchArea { clicked => { root.audio-shelf = index; } }
                }
            }

            if root.audio-shelf > 0: VoiceList {
                styles: root.audio-shelf == 2;
                touch-sized: true;
                opened => { root.hide(); }

                // A recording from the phone's files kept as a voice. The
                // sheet stays up under the New voice sheet, so the voice
                // is there to see once it is saved.
                if root.audio-shelf == 1: VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 8px;
                    SheetButton {
                        glyph: Glyph.import;
                        primary: true;
                        label: I18n.t("voices.importVoice");
                        clicked => { Sounds.voice-import(); }
                    }
                }
            }

            if root.audio-shelf == 0: SheetButton {
                glyph: Glyph.import;
                primary: true;
                enabled: !Sounds.importing;
                label: Sounds.importing ? I18n.t("mediaPane.importing") : I18n.t("sounds.importSounds");
                clicked => { Sounds.import(); }
            }
            if root.audio-shelf == 0: SheetNote {
                text: Sounds.mine.length == 0
                    ? I18n.t("sounds.noSoundsYet") : I18n.t("sounds.mineHintPhone");
            }
            if root.audio-shelf == 0: SoundList {
                items: Sounds.mine;
                touch-sized: true;
                added => { root.hide(); }
            }
        }

        // ── titles ──
        if root.sheet == "text": VerticalLayout {
            padding: 12px;
            spacing: 12px;

            SheetButton {
                glyph: Glyph.plus;
                primary: true;
                label: I18n.t("phone.addATitle");
                clicked => {
                    Editor.library-add-text("default");
                    root.hide();
                }
            }
            SheetNote { text: I18n.t("phone.looks"); }
            PresetGrid {
                items: Editor.text-presets;
                applied(id) => {
                    Editor.library-add-text(id);
                    root.hide();
                }
            }
        }

        // ── effects, with nothing selected ──
        if root.sheet == "effects": VerticalLayout {
            padding: 12px;
            spacing: 8px;

            if !root.has-clip: SheetNote { text: I18n.t("phone.selectClipFirst"); }
            ShelfSearch {
                shelf: 1;
                placeholder: I18n.t1("common.searchKind", I18n.t("common.effect"));
            }
            CategoryPillBar {
                current: Library.view(1).category;
                picked(cat) => { Library.category-changed(1, cat); }
            }
            ShelfGrid {
                entries: Editor.catalogue-effects;
                glyph: Glyph.sparkle;
                auditions: false;
                applied(id, label) => { Editor.effect-preview("effect", id, label); }
            }
        }

        // ── the selected clip's effects: its chain, then the shelf ──
        if root.sheet == "clip-effects": VerticalLayout {
            spacing: 0px;

            PresetStack {
                noun: I18n.t("common.effect");
                library-title: I18n.t("common.effects");
                library: false;
                empty-note: I18n.t("phone.noEffectYet");
                shelf: 1;
                group-labels: Editor.effect-groups;
                catalogue: Editor.catalogue-effects;
                applied: Editor.applied-visual;
                params: Editor.visual-params;
                wheel-groups: Editor.visual-wheels;
                curve-groups: Editor.visual-curves;
                colours: Editor.visual-colours;
                choices: Editor.visual-choices;

                add(id) => { Editor.chain-add(false, id); }
                toggle(index) => { Editor.chain-toggle(false, index); }
                move-by(index, delta) => { Editor.chain-move-by(false, index, delta); }
                remove(index) => { Editor.chain-remove(false, index); }
                set-param(index, key, value) => {
                    Editor.chain-set-param(false, index, key, value);
                }
                set-colour(index, key, value) => {
                    Editor.chain-set-colour(index, key, value);
                }
                pick-colour(index, key) => { Editor.chain-pick-colour(index, key); }
                auto-colour(index, key) => { Editor.chain-auto-colour(index, key); }
                curve-point(index, key, point, x, y) => {
                    Editor.curve-point(index, key, point, x, y);
                }
                curve-remove(index, key, point) => {
                    Editor.curve-remove(index, key, point);
                }
                commit => { Editor.clip-commit(); }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                ShelfSearch {
                    shelf: 1;
                    placeholder: I18n.t1("common.searchKind", I18n.t("common.effect"));
                }
                CategoryPillBar {
                    current: Library.view(1).category;
                    picked(cat) => { Library.category-changed(1, cat); }
                }
                ShelfGrid {
                    entries: Editor.catalogue-effects;
                    glyph: Glyph.sparkle;
                    auditions: false;
                    applied(id, label) => { Editor.effect-preview("effect", id, label); }
                }
            }
        }

        // ── filters: a look laid over the cut at the playhead ──
        if root.sheet == "filters": VerticalLayout {
            padding: 12px;
            spacing: 8px;

            ShelfSearch {
                shelf: 0;
                placeholder: I18n.t1("common.searchKind", I18n.t("mediaPane.filter"));
            }
            GroupPillBar {
                shelf: 0;
                groups: Editor.filter-groups;
            }
            ShelfGrid {
                entries: Editor.catalogue-filters;
                auditions: false;
                applied(id, label) => {
                    Editor.effect-preview("filter", id, label);
                }
            }
        }

        // ── adjustments: a layer that grades everything beneath it, and
        // the user's LUTs - imported from the phone's files, put down as
        // a layer at the playhead ──
        if root.sheet == "adjustments": VerticalLayout {
            padding: 12px;
            spacing: 12px;

            SheetButton {
                glyph: Glyph.plus;
                primary: true;
                label: I18n.t("mediaPane.addAdjustmentLayer");
                clicked => {
                    Editor.library-add-adjustment(I18n.t("mediaPane.adjustment"));
                    root.hide();
                }
            }
            SheetNote { text: I18n.t("mediaPane.adjustmentLayerHint"); }
            SheetNote { text: I18n.t("mediaPane.luts"); }
            SheetButton {
                glyph: Glyph.import;
                label: I18n.t("mediaPane.importALut");
                clicked => { Editor.library-import-lut(); }
            }
            if Editor.catalogue-luts.length == 0: SheetNote {
                text: I18n.t("mediaPane.noLutsYet");
            }
            ShelfGrid {
                entries: Editor.catalogue-luts;
                glyph: Glyph.sun;
                auditions: false;
                applied(id, label) => {
                    Editor.library-apply-lut(id, label);
                    root.hide();
                }
            }
            for lut in Editor.catalogue-luts: SheetButton {
                visible: lut.category == "Imported";
                label: I18n.t("mobile.removeLut") + " · " + lut.name; glyph: Glyph.trash;
                clicked => { Editor.library-remove-lut(lut.id); }
            }

        }

        // ── transitions: onto the cut into the selected clip ──
        if root.sheet == "transitions": VerticalLayout {
            padding: 12px;
            spacing: 8px;

            if !root.has-clip: SheetNote { text: I18n.t("phone.selectClipFirst"); }
            ShelfSearch {
                shelf: 3;
                placeholder: I18n.t1("common.searchKind", I18n.t("mediaPane.transition"));
            }
            GroupPillBar {
                shelf: 3;
                groups: Editor.transition-groups;
            }
            ShelfGrid {
                entries: Editor.catalogue-transitions;
                glyph: Glyph.transition;
                auditions: false;
                applied(id, label) => { Editor.effect-preview("transition", id, label); }
            }
        }

        // ── the inspector's pages ──
        if root.sheet == "canvas": PhoneCanvas { own: false; }
        if root.sheet == "clip-canvas": VerticalLayout {
            spacing: 8px;
            PhoneCommand {
                label: I18n.t("clipInspector.crop");
                enabled: Editor.phone-can-grade;
                clicked => { root.show("clip-crop", true); }
            }
            PhoneCanvas { own: true; }
        }

        if root.sheet == "clip-crop": VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 4px;
                for name[i] in root.crop-labels: PhoneCommand {
                    label: name;
                    selected: root.crop-side == i;
                    enabled: Editor.phone-can-grade;
                    clicked => { Editor.blur(); root.crop-side = i; }
                }
            }
            PhoneValue {
                label: root.crop-labels[root.crop-side];
                unit: "%";
                maximum: 100 * Math.max(0, 0.9 - (root.crop-side == 0 ? Editor.selected-clip.crop-right
                    : root.crop-side == 1 ? Editor.selected-clip.crop-bottom
                    : root.crop-side == 2 ? Editor.selected-clip.crop-left
                    : Editor.selected-clip.crop-top));
                step: 0.5;
                value: 100 * (root.crop-side == 0 ? Editor.selected-clip.crop-left
                    : root.crop-side == 1 ? Editor.selected-clip.crop-top
                    : root.crop-side == 2 ? Editor.selected-clip.crop-right
                    : Editor.selected-clip.crop-bottom);
                enabled: Editor.phone-can-grade;
                started => { Editor.phone-edit-started(); }
                edited(v) => {
                    Editor.clip-set(root.crop-side == 0 ? ClipField.crop-left
                        : root.crop-side == 1 ? ClipField.crop-top
                        : root.crop-side == 2 ? ClipField.crop-right : ClipField.crop-bottom, v / 100);
                    Editor.phone-edit-preview();
                }
                finished => { Editor.phone-edit-finished(); }
            }
        }

        if root.sheet == "clip-mask": PhoneMaskPanel {
            selected: Editor.selected-clip;
            set(field, value) => { Editor.clip-set(field, value); }
            commit => { Editor.clip-commit(); }
        }

        if root.sheet == "clip-video": VideoPanel {
            // Fit, Fill and the background have the Canvas sheet here, and
            // the mask its own tool and sheet.
            canvas: false;
            mask-section: false;
            selected: Editor.selected-clip;
            applied: Editor.applied-visual;
            params: Editor.visual-params;
            colours: Editor.visual-colours;
            choices: Editor.visual-choices;
            brush-tool: Editor.brush-tool;
            brush-size: Editor.brush-size;
            painting: Editor.painting;
            set(field, value) => { Editor.clip-set(field, value); }
            commit => { Editor.clip-commit(); }
            chain-add(id) => { Editor.chain-add(false, id); }
            chain-remove(index) => { Editor.chain-remove(false, index); }
            chain-set-param(index, key, value) => {
                Editor.chain-set-param(false, index, key, value);
            }
            chain-set-colour(index, key, value) => {
                Editor.chain-set-colour(index, key, value);
            }
            chain-pick-colour(index, key) => { Editor.chain-pick-colour(index, key); }
            chain-auto-colour(index, key) => { Editor.chain-auto-colour(index, key); }
            cutout-mode(mode) => { Editor.cutout-mode(mode); }
            cutout-tool(index) => { Editor.cutout-tool(index); }
            cutout-size(size) => { Editor.cutout-size(size); }
            cutout-painting(on) => { Editor.cutout-painting(on); }
            cutout-subject(index) => { Editor.cutout-subject(index); }
            cutout-clear => { Editor.cutout-clear(); }
        }

        if root.sheet == "clip-animate": AnimatePanel {
            selected: Editor.selected-clip;
            set(field, value) => { Editor.clip-set(field, value); }
            commit => { Editor.clip-commit(); }
        }

        if root.sheet == "clip-speed": PhoneSpeed {
            expanded <=> root.expanded-tool;
            can-interpolate: root.is-video && (SpeedRamp.has-curve
                ? SpeedRamp.trough-speed > 0 && SpeedRamp.trough-speed < 1
                : Editor.selected-clip.speed < 1);
        }

        if root.sheet == "clip-trim": VerticalLayout {
            spacing: 8px;
            Text {
                text: Fmt.frames-timecode(Editor.playhead, Editor.frame-rate);
                color: Theme.fg;
                font-family: Theme.font-technical;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                spacing: 6px;
                PhoneCommand { label: I18n.t("previewPane.previousFrame"); clicked => { Editor.step-frames(-1); } }
                PhoneCommand { label: I18n.t("previewPane.nextFrame"); clicked => { Editor.step-frames(1); } }
            }
            HorizontalLayout {
                spacing: 6px;
                PhoneCommand { label: I18n.t("shortcuts.deleteLeft"); enabled: Editor.can-trim-selection; clicked => { Editor.shortcut("delete-left"); } }
                PhoneCommand { label: I18n.t("shortcuts.deleteRight"); enabled: Editor.can-trim-selection; clicked => { Editor.shortcut("delete-right"); } }
            }
        }

        if root.sheet == "clip-audio": VerticalLayout {
            spacing: 8px;
            PhoneAudioGain { }
            PhoneCommand {
                label: root.expanded-tool ? I18n.t("configPane.basic") : I18n.t("phone.more");
                selected: root.expanded-tool;
                clicked => { root.expanded-tool = !root.expanded-tool; }
            }
            if root.expanded-tool && Editor.selected-clip.has-sound: AudioEnvelope {
                selected: Editor.selected-clip;
                started => { Editor.phone-edit-started(); }
                edited(a, b) => { Editor.audio-fades-edited(a, b); }
                committed => { Editor.phone-edit-finished(); }
            }
            if root.expanded-tool: AudioPanel {
                with-speed: root.kind == ClipKind.audio;
                show-fade-graph: false;
                selected: Editor.selected-clip;
                audio-tracks: Editor.audio-tracks;
                set(field, value) => { Editor.clip-set(field, value); }
                commit => { Editor.clip-commit(); }
            }
            if root.expanded-tool: ProcessorRows {
                applied: Editor.applied-audio;
                params: Editor.audio-params;
                add(id) => { Editor.chain-add(true, id); }
                remove(index) => { Editor.chain-remove(true, index); }
                set-param(index, key, value) => { Editor.chain-set-param(true, index, key, value); }
                commit => { Editor.clip-commit(); }
            }
        }

        if root.sheet == "clip-audio-effects": VerticalLayout {
            if !Editor.selected-clip.batch-volume: PresetStack {
                noun: I18n.t("common.audioEffect");
                library-title: I18n.t("configPane.audioEffects");
                shelf: 2;
                hidden: ["concat.loudness", "concat.denoise", "concat.enhance-voice"];
                group-labels: Editor.audio-groups;
                catalogue: Editor.catalogue-audio;
                applied: Editor.applied-audio;
                params: Editor.audio-params;

                add(id) => { Editor.chain-add(true, id); }
                toggle(index) => { Editor.chain-toggle(true, index); }
                move-by(index, delta) => { Editor.chain-move-by(true, index, delta); }
                remove(index) => { Editor.chain-remove(true, index); }
                set-param(index, key, value) => {
                    Editor.chain-set-param(true, index, key, value);
                }
                commit => { Editor.clip-commit(); }
            }
        }

        if root.sheet == "clip-adjust": AdjustPanel {
            params: Editor.adjust-params;
            wheels: Editor.adjust-wheels;
            curves: Editor.adjust-curves;
            set(key, value) => { Editor.adjust-set(key, value); }
            curve-point(key, point, x, y) => { Editor.curve-point(-1, key, point, x, y); }
            curve-remove(key, point) => { Editor.curve-remove(-1, key, point); }
            commit => { Editor.clip-commit(); }
        }

        if root.sheet == "clip-enhance": EnhancePanel {
            selected: Editor.selected-clip;
            enhance-set(on) => { Editor.clip-enhance-set(on); }
            enhance-scale(scale) => { Editor.clip-enhance-scale(scale); }
            enhance-strength(strength) => { Editor.clip-enhance-strength(strength); }
            enhance-preview => { Editor.clip-enhance-preview(); }
            enhance-run => { Editor.clip-enhance-run(); }
        }

        if root.sheet == "clip-text": TextPanel {
            selected: Editor.selected-clip;
            families: Editor.font-families;
            set(field, value) => { Editor.clip-set(field, value); }
            set-text(field, value) => { Editor.clip-set-text(field, value); }
            set-words(text, caret) => { Editor.clip-set-words(text, caret); }
            select-words(anchor, cursor) => { Editor.clip-select-words(anchor, cursor); }
            reset-words => { Editor.clip-reset-words(); }
            set-colour(field, value) => { Editor.clip-set-colour(field, value); }
            commit => { Editor.clip-commit(); }
            import-font => { Editor.import-font(); }
            set-default => { Editor.text-style-default(); }
        }

        if root.sheet == "clip-shape": ShapePanel {
            selected: Editor.selected-clip;
            set(field, value) => { Editor.clip-set(field, value); }
            set-colour(which, value) => { Editor.clip-shape-colour(which, value); }
            commit => { Editor.clip-commit(); }
        }

        if root.sheet == "clip-layer": FilterPanel {
            selected: Editor.selected-clip;
            set(field, value) => { Editor.clip-set(field, value); }
            commit => { Editor.clip-commit(); }
        }

        if root.sheet == "tools": VerticalLayout {
            padding: 4px; spacing: 4px;
            if Editor.mobile-more-tools.length > 0: ToolGrid {
                tools: Editor.mobile-more-tools;
                activated(id) => { root.hide(); root.activate-tool(id); }
            }
            if root.sheet-needs-clip && Editor.mobile-more-tools.length > 0: Rectangle {
                height: 1px;
                background: Theme.line;
            }
            for item in root.sheet-needs-clip ? Editor.menu-items : []: Rectangle {
                property <bool> included: item.kind == MenuRow.action && item.id != "split"
                    && item.id != "delete" && item.id != "delete-left" && item.id != "delete-right"
                    && item.id != "merge";
                height: self.included ? 48px : 0px;
                if self.included: MenuAction {
                    label: item.label;
                    glyph: item.checkable && item.checked ? Glyph.check : item.glyph;
                    enabled: item.enabled; compact: true;
                    clicked => {
                        root.hide();
                        Editor.menu-selected(item.id);
                        if (item.id == "enhance") { root.show("clip-enhance", true); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            MenuAction {
                glyph: Glyph.sliders; label: I18n.t("mobile.customizeTools"); compact: true;
                clicked => { root.show("customize-tools", root.has-clip); }
            }
        }
        if root.sheet == "customize-tools": VerticalLayout {
            padding: 12px; spacing: 8px;
            SheetNote { text: I18n.t("mobile.customizeToolsHint"); }
            for tool in Editor.mobile-all-tools: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    height: 44px; spacing: 8px;
                    VerticalLayout { alignment: center; Icon { glyph: tool.glyph; size: 20px; tint: Theme.fg; } }
                    Text { text: tool.label; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    RoundButton { glyph: Glyph.chevron-up; label: I18n.t("mobile.moveToolUp"); clicked => { Editor.mobile-tool-customize(tool.id, "up"); } }
                    RoundButton { glyph: Glyph.chevron-down; label: I18n.t("mobile.moveToolDown"); clicked => { Editor.mobile-tool-customize(tool.id, "down"); } }
                }
                SwitchRow { label: I18n.t("mobile.showTool"); checked: !tool.hidden; toggled(on) => { Editor.mobile-tool-customize(tool.id, "hide"); } }
                if !root.has-clip: SwitchRow { label: I18n.t("mobile.pinTool"); checked: tool.pinned; toggled(on) => { Editor.mobile-tool-customize(tool.id, "pin"); } }
            }
        }

        if root.sheet == "track-controls" && root.track-index < Editor.tracks.length: VerticalLayout {
            padding: 16px; spacing: 12px;
            Text { text: I18n.t1("atlas.trackOptions", Editor.tracks[root.track-index].label); color: Theme.accent; font-size: 16px; }
            HorizontalLayout {
                height: 80px; spacing: 8px;
                ToolItem { width: (root.width - 80px) / 4; glyph: Editor.tracks[root.track-index].visible ? Glyph.eye : Glyph.eye-off; label: I18n.t("atlas.visible"); current: Editor.tracks[root.track-index].visible; clicked => { let tr = Editor.tracks[root.track-index]; Editor.track-flag-changed(root.track-index, !tr.visible, tr.muted, tr.locked); } }
                ToolItem { width: (root.width - 80px) / 4; glyph: Editor.tracks[root.track-index].muted ? Glyph.volume-off : Glyph.volume; label: I18n.t("atlas.muteAudio"); current: Editor.tracks[root.track-index].muted; clicked => { let tr = Editor.tracks[root.track-index]; Editor.track-flag-changed(root.track-index, tr.visible, !tr.muted, tr.locked); } }
                ToolItem { width: (root.width - 80px) / 4; glyph: Glyph.lock; label: I18n.t("atlas.lockTrack"); current: Editor.tracks[root.track-index].locked; clicked => { let tr = Editor.tracks[root.track-index]; Editor.track-flag-changed(root.track-index, tr.visible, tr.muted, !tr.locked); } }
                ToolItem { width: (root.width - 80px) / 4; glyph: Glyph.fold; label: Editor.tracks[root.track-index].minimized ? I18n.t("atlas.expandTrack") : I18n.t("atlas.minimizeTrack"); clicked => { Editor.track-minimized(root.track-index, !Editor.tracks[root.track-index].minimized); } }
            }
            Text { text: I18n.t("atlas.trackHeight"); color: Theme.fg; font-size: 14px; }
            HorizontalLayout { spacing: 8px; height: 76px;
                ToolItem { width: (root.width - 72px) / 3; glyph: Glyph.minus; label: I18n.t("common.small"); clicked => { Editor.track-minimized(root.track-index, false); Editor.track-sized(root.track-index, TrackSize.small); } }
                ToolItem { width: (root.width - 72px) / 3; glyph: Glyph.frame; label: I18n.t("common.medium"); clicked => { Editor.track-minimized(root.track-index, false); Editor.track-sized(root.track-index, TrackSize.medium); } }
                ToolItem { width: (root.width - 72px) / 3; glyph: Glyph.fit; label: I18n.t("common.large"); clicked => { Editor.track-minimized(root.track-index, false); Editor.track-sized(root.track-index, TrackSize.large); } }
            }
        }
        // ── the project's facts, and the sheet that changes them ──
        if root.sheet == "project": VerticalLayout {
            SheetButton {
                label: I18n.t("mobile.exportProject"); glyph: Glyph.export;
                clicked => { Editor.export-project-package(); }
            }
            padding: 16px;
            spacing: 0px;

            Fact { label: I18n.t("common.name"); value: Editor.project-name; }
            Fact { label: I18n.t("configPane.folder"); value: Editor.project-folder; }
            Fact { label: I18n.t("configPane.timeline"); value: Editor.timeline-name; }
            Fact { label: I18n.t("common.frame"); value: Editor.project-output; }
            Fact { label: I18n.t("common.rate"); value: Editor.project-rate; }
            Fact { label: I18n.t("common.duration"); value: Editor.project-duration; }
            Fact { label: I18n.t("common.media"); value: "\{Editor.count-media}"; }
            Fact { label: I18n.t("configPane.tracks"); value: "\{Editor.count-tracks}"; }
            Fact { label: I18n.t("configPane.clips"); value: "\{Editor.count-clips}"; }


            Rectangle { height: 16px; }

            SheetButton {
                glyph: Glyph.settings;
                label: I18n.t("configPane.modify");
                clicked => {
                    root.hide();
                    Editor.modify-project();
                }
            }
        }
    }

    if Editor.effect-preview-active: Rectangle {
        y: root.height - 64px; width: root.width; height: 64px; background: Theme.panel;
        HorizontalLayout { padding: 10px; spacing: 12px;
            SheetButton { glyph: Glyph.close; label: I18n.t("common.cancel"); clicked => { Editor.effect-preview-finish(false); } }
            SheetButton { glyph: Glyph.check; primary: true; label: I18n.t("common.apply"); clicked => { Editor.effect-preview-finish(true); root.hide(); } }
        }
    }
    // ── the Add bar ──────────────────────────────────────────────────
    //
    // Pinned to the foot of the bin while anything is picked, over the
    // grid rather than in its scroll, so it is under the thumb however far
    // down the picks are; it follows the sheet when the sheet is dragged.
    if root.sheet == "media" && Editor.media-selected-count > 0: Rectangle {
        x: 0;
        y: root.height - root.add-bar-h + sheet.drag;
        width: root.width;
        height: root.add-bar-h;
        background: Theme.panel;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.line;
        }

        // Swallows the presses around the button, so they do not fall
        // through to the grid under the bar.
        TouchArea { }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 12px;
            padding-bottom: 12px;

            SheetButton {
                horizontal-stretch: 1;
                glyph: Glyph.plus;
                primary: true;
                label: I18n.t1("phone.addPicked", Editor.media-selected-count);
                clicked => {
                    Editor.media-add-picked(root.media-at-end);
                    root.hide();
                }
            }
        }
    }

    project-menu := PhoneMenu {
        property <bool> open-state;
        width: root.width; height: root.height; open: self.open-state;
        anchor-x: 56px; closed => { project-menu.open-state = false; }
        MenuAction { glyph: Glyph.folder; label: I18n.t("mobile.exportProjectMenu"); clicked => { project-menu.open-state = false; Editor.export-project-package(); } }
        MenuAction { glyph: Glyph.sliders; label: I18n.t("mobile.projectSettings"); clicked => { project-menu.open-state = false; Editor.modify-project(); } }
        MenuAction { glyph: Glyph.info; label: I18n.t("phone.project"); clicked => { project-menu.open-state = false; root.show("project", false); } }
    }
    if Editor.preview-fullscreen: FullscreenPlayer {
        width: root.width; height: root.height; project-name: root.project-name;
        closed => { root.set-fullscreen(false); }
    }

}
