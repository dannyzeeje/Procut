import { Theme } from "../theme/theme.slint";
import { Editor } from "../editor.slint";
import { I18n } from "../i18n.slint";
import { Glyph } from "../icons.slint";
import { ToolItem } from "controls.slint";
export component PhoneQuickActions inherits Rectangle {
    in property <bool> has-clip;
    callback media(); callback audio(); callback text-tool(); callback tools(); callback done(); callback edit();
Rectangle {
        width: root.width; height: root.height;
        background: Theme.panel;
        if !root.has-clip: HorizontalLayout {
            padding: 4px; spacing: 0px;
            ToolItem { width: (root.width - 8px) / 4; glyph: Glyph.film; label: I18n.t("common.media"); clicked => { root.media(); } }
            ToolItem { width: (root.width - 8px) / 4; glyph: Glyph.music; label: I18n.t("common.audio"); clicked => { root.audio(); } }
            ToolItem { width: (root.width - 8px) / 4; glyph: Glyph.text-mark; label: I18n.t("common.text"); clicked => { root.text-tool(); } }
            ToolItem { width: (root.width - 8px) / 4; glyph: Glyph.more; label: I18n.t("mobile.allTools"); clicked => { root.tools(); } }
        }
        if root.has-clip: HorizontalLayout {
            padding: 4px; spacing: 0px;
            ToolItem { width: (root.width - 8px) / 5; glyph: Glyph.chevron-left; label: I18n.t("mobile.done"); clicked => { root.done(); Editor.shortcut("deselect"); } }
            ToolItem { width: (root.width - 8px) / 5; glyph: Glyph.split; label: I18n.t("phone.split"); clicked => { Editor.shortcut("split-selected"); } }
            ToolItem { width: (root.width - 8px) / 5; glyph: Glyph.trash; label: I18n.t("common.delete"); clicked => { Editor.delete-selected(); } }
            ToolItem { width: (root.width - 8px) / 5; glyph: Glyph.frame; label: I18n.t("phone.edit"); clicked => { root.edit(); } }
            ToolItem { width: (root.width - 8px) / 5; glyph: Glyph.more; label: I18n.t("mobile.allTools"); clicked => { root.tools(); } }
        }
    }
}
