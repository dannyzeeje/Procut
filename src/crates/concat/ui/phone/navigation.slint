import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
export global PhoneNavigation { in-out property <bool> open; }
export component MenuAction inherits Rectangle {
    in property <string> label;
    in property <Glyph> glyph;
    in property <bool> enabled: true;
    in property <bool> current;
    in property <bool> compact;
    callback clicked();
    height: root.compact ? 48px : 52px;
    min-width: 0px;
    accessible-role: button;
    accessible-label: root.label;
    border-radius: 6px;
    background: touch.pressed || root.current ? Theme.field-active : Colors.transparent;
    opacity: root.enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 16px; padding-right: 12px; spacing: 14px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 20px; tint: root.current ? Theme.accent : Theme.fg; } }
        Text { text: root.label; min-width: 0px; color: Theme.fg; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
export component PhoneMenu inherits Rectangle {
    in property <bool> open;
    in property <length> anchor-x: 12px;
    in property <length> anchor-y: 52px;
    callback closed();
    visible: root.open;
    background: #00000044;
    TouchArea { clicked => { root.closed(); } }
    Rectangle {
        x: Math.max(12px, Math.min(root.anchor-x, root.width - self.width - 12px));
        y: root.anchor-y;
        width: Math.min(258px, root.width - 24px);
        height: Math.min(root.height - root.anchor-y - 12px, content.preferred-height);
        background: Theme.raised;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.line-strong;
        clip: true;
        TouchArea { }
        Flickable {
            content-width: self.width; content-height: content.preferred-height;
            content := VerticalLayout {
                x: 0; y: 0;
                width: parent.width; height: self.preferred-height;
                padding: 6px;
                alignment: start;
                @children
            }
        }
    }
}
