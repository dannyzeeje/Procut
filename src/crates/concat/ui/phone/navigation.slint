import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { I18n } from "../i18n.slint";
import { RoundButton } from "controls.slint";
export global PhoneNavigation { in-out property <bool> open; }
export component MenuAction inherits Rectangle {
    in property <string> label;
    in property <Glyph> glyph;
    in property <bool> enabled: true;
    in property <bool> current;
    callback clicked();
    height: 52px;
    border-radius: 14px;
    background: touch.pressed || root.current ? Theme.field-active : Theme.field;
    opacity: root.enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 16px; padding-right: 12px; spacing: 14px;
        VerticalLayout { alignment: center; Icon { glyph: root.glyph; size: 22px; tint: Theme.fg; } }
        Text { text: root.label; color: Theme.fg; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        VerticalLayout { alignment: center; Icon { glyph: Glyph.chevron-right; size: 16px; tint: Theme.fg-muted; } }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
export component PhoneMenu inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    callback closed();
    visible: root.open;
    background: #00000099;
    TouchArea { clicked => { root.closed(); } }
    Rectangle {
        x: 0; y: 0;
        width: Math.min(320px, root.width - 32px); height: parent.height;
        background: Theme.panel;
        border-top-right-radius: 24px; border-bottom-right-radius: 24px;
        TouchArea { }
        Flickable {
            content-width: self.width; content-height: content.preferred-height;
            content := VerticalLayout {
                x: 0; y: 0;
                width: parent.width; height: self.preferred-height;
                padding: 16px; spacing: 10px; alignment: start;
                HorizontalLayout {
                    height: 56px; spacing: 12px;
                    Image { source: @image-url("../../../../../assets/procut-logo.png"); width: 42px; height: 42px; image-fit: contain; }
                    Text { text: root.title; color: Theme.fg; font-size: 22px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    RoundButton { glyph: Glyph.close; label: I18n.t("common.close"); clicked => { root.closed(); } }
                }
                @children
            }
        }
    }
}
